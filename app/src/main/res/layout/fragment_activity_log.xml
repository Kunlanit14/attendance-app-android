<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tbActivitiesLog"
    android:layout_width="match_parent"
    android:layout_height="700dp"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="8dp"
    tools:context=".fragment.activityLog.ActivityLogFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:layout_gravity="center_horizontal">

        <TableLayout
            android:id="@+id/tbLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:stretchColumns="*"
            android:padding="8dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp">

            <TableRow android:id="@+id/tbRow1">

                <TextView
                    android:id="@+id/tvDateRequest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/cell_shape"
                    android:padding="10dp"
                    android:singleLine="false"
                    android:text="Date request"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRequestType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/cell_shape"
                    android:padding="10dp"
                    android:text="Request type"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/cell_shape"
                    android:padding="10dp"
                    android:text="Detail"
                    android:textColor="@color/white"
                    android:textStyle="bold" />
            </TableRow>
        </TableLayout>
    </LinearLayout>




</ScrollView>